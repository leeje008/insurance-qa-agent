# === Database ===
# 로컬 개발 시: localhost 사용
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insurance_qa
# Docker 실행 시: 서비스명(db)으로 변경
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/insurance_qa

# === Ollama (Local LLM) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text

# === App ===
APP_ENV=development
LOG_LEVEL=DEBUG
